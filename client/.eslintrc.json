{
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true
  },
  "extends": ["airbnb-base", "plugin:jquery/slim", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "jquery/no-ajax": "off",
    "import/no-unresolved": "off",
    "prettier/prettier": ["error", {
      "singleQuote": true,
      "semi": false,
      "printWidth": 100
    }]
  }
}