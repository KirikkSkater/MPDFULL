                        <equals value="com.irkut.tc.irmapplication.IRMApplication" />
                    </with>
                </or>
            </and>
        </definition>
   </extension-->	
   
   <extension point="org.eclipse.ui.commands">
        <command id="com.irkut.tc.mpdeapplication.sendto"
            name="%mpdeApplication.TITLE"/>  
            
        <command id="com.irkut.tc.mpdeapplication.startserver"
            name="start server"/> 
            
        <command id="com.irkut.tc.mpdeapplication.openmd"
            name="Открыть редактор MPD"/>  
   </extension>	

<!-- COMMANDS -->

   
   
   <extension	point="org.eclipse.ui.handlers">
   
      <!--handler	commandId="com.irkut.tc.irm.create.CBReq"		class="com.irkut.tc.irm.handlers.CreateHandler">
      		<enabledWhen>
                   <with variable="activePartId">
                	<equals 
                    	value="com.irkut.tc.irmapplication.IRMView"/>
            		</with>  	
      		</enabledWhen>
      </handler-->
      
      
      <handler	commandId="com.irkut.tc.mpdeapplication.startserver"		class="com.irkut.tc.mpdeditor.handlers.HandlerStartServer"></handler>
      <handler	commandId="com.irkut.tc.mpdeapplication.openmd"		class="com.irkut.tc.mpdeditor.handlers.HandlerMPDObject">
      		
      </handler>
      
   </extension>                                  

   <extension point="org.eclipse.ui.menus">
     <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=tools">
		<!--command commandId="com.irkut.tc.mpdeapplication.startserver">
            </command>
        <command commandId="com.irkut.tc.mpdeapplication.openmd">
            </command-->
     </menuContribution>
     
     <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=group.subscribe"> <!-- ?after=tools"> -->
         <menu id="com.irkut.tc.mpd.popupmenu" label="Редактор MPD">
         <command commandId="com.irkut.tc.mpdeapplication.openmd">
            </command>
          <!-- Контекстное меню для приложения "Менеджер структуры"  -->
			<visibleWhen>
		            <iterate ifEmpty="false">
	            	<and>
		                 <adapt type="com.teamcenter.rac.kernel.TCComponent">
			                  <test property="com.teamcenter.rac.kernel.TCComponent.typeClass" value="C3D_ItemS1000D4,C3D_ItemS1000D4Revision" />
			                  
		                 </adapt>
		             </and>
               
		            </iterate>        	
            	</visibleWhen>
		</menu>
         
	  </menuContribution>
   
   </extension>  
      

   <extension
         point="org.eclipse.ui.menus">
         
            <menuContribution locationURI="menu:tools">   
             
      		</menuContribution>
      

      
   </extension>
